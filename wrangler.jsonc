{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loophole",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "build": { "command": "npm run build" },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "kv_namespaces": [{ "binding": "CONFIG","id": "89fb50df1cbb4e868276c4904a3be3d2" }],
  "durable_objects": { "bindings": [{ "name": "AUTH", "class_name": "AuthObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthObject"] }],
  "observability": { "enabled": false },
}
